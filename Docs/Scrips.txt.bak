//TABLA USUARIOS

CREATE TABLE "REPORTUSER"."USUARIO_CONTROL_DESCUENTO"
(
    "ID"              NUMBER GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL ENABLE, 
    "NOMBRE"          VARCHAR2(100) NOT NULL ENABLE,
    "EMAIL"           VARCHAR2(100) NOT NULL ENABLE,
    "FECHA_CREACION"  TIMESTAMP(0) WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL ENABLE, 
    "PASSWORD"        VARCHAR2(256) NOT NULL ENABLE, 

    CONSTRAINT "USUARIO_CONTROL_DESCUENTO_PK" PRIMARY KEY ("ID")
    USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS
    STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
    PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
    BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
    TABLESPACE "USERS" ENABLE
)
SEGMENT CREATION IMMEDIATE
PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
NOCOMPRESS LOGGING
STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
TABLESPACE "USERS";



//TABLA USUARIO_COORDENADA


  CREATE TABLE "REPORTUSER"."USUARIO_COORDENADA" 
   (	"ID" NUMBER GENERATED BY DEFAULT AS IDENTITY MINVALUE 1 MAXVALUE 9999999999999999999999999999 INCREMENT BY 1 START WITH 1 CACHE 20 NOORDER  NOCYCLE  NOT NULL ENABLE, 
	"EMAIL" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
	"SID" NUMBER NOT NULL ENABLE, 
	"TIENDA" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
	"MAX_DESCUENTO" NUMBER(5,2) NOT NULL ENABLE, 
	"CICLO_COORDENADA" NUMBER(5,2) NOT NULL ENABLE, 
	 CONSTRAINT "USUARIO_COORDENADA_PK" PRIMARY KEY ("ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "USERS"  ENABLE
   ) SEGMENT CREATION IMMEDIATE 
  PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
 NOCOMPRESS LOGGING
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "USERS" ;
  
  // TABLA COOORDENADAS
  
  CREATE TABLE "REPORTUSER"."COORDENADAS" 
(
    "ID" NUMBER GENERATED BY DEFAULT AS IDENTITY 
        MINVALUE 1 
        MAXVALUE 9999999999999999999999999999 
        INCREMENT BY 1 
        START WITH 1 
        CACHE 20 
        NOORDER 
        NOCYCLE 
        NOT NULL ENABLE, 
    "A1" NUMBER, 
    "B1" NUMBER, 
    "C1" NUMBER, 
    "D1" NUMBER, 
    "E1" NUMBER, 
    "F1" NUMBER, 
    "G1" NUMBER, 
    "H1" NUMBER, 
    "I1" NUMBER, 
    "J1" NUMBER, 
    "A2" NUMBER, 
    "B2" NUMBER, 
    "C2" NUMBER, 
    "D2" NUMBER, 
    "E2" NUMBER, 
    "F2" NUMBER, 
    "G2" NUMBER, 
    "H2" NUMBER, 
    "I2" NUMBER, 
    "J2" NUMBER, 
    "A3" NUMBER, 
    "B3" NUMBER, 
    "C3" NUMBER, 
    "D3" NUMBER, 
    "E3" NUMBER, 
    "F3" NUMBER, 
    "G3" NUMBER, 
    "H3" NUMBER, 
    "I3" NUMBER, 
    "J3" NUMBER, 
    "A4" NUMBER, 
    "B4" NUMBER, 
    "C4" NUMBER, 
    "D4" NUMBER, 
    "E4" NUMBER, 
    "F4" NUMBER, 
    "G4" NUMBER, 
    "H4" NUMBER, 
    "I4" NUMBER, 
    "J4" NUMBER, 
    "A5" NUMBER, 
    "B5" NUMBER, 
    "C5" NUMBER, 
    "D5" NUMBER, 
    "E5" NUMBER, 
    "F5" NUMBER, 
    "G5" NUMBER, 
    "H5" NUMBER, 
    "I5" NUMBER, 
    "J5" NUMBER, 
    "USUARIO_COORDENADA_ID" VARCHAR2(100 BYTE), 
    "FECHAS_UPDATE" TIMESTAMP(0) WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL ENABLE,
    CONSTRAINT "COORDENADAS_PK" PRIMARY KEY ("ID") 
    USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
    STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645 
        PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1 
        BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT) 
    TABLESPACE "USERS" ENABLE
)
SEGMENT CREATION IMMEDIATE 
PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
NOCOMPRESS LOGGING 
STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645 
    PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1 
    BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT) 
TABLESPACE "USERS";


